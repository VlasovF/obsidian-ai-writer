# Docker
DOCKER_PREFIX=obsidian
DOCKER_NETWORK=obsidian_network
OLLAMA_NETWORK=ollama_network

# API
API_PORT=8000

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_LLM_MODEL=mistral:7b-instruct-v0.3-q4_K_M
OLLAMA_TIMEOUT=60

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=obsidian_notes
QDRANT_API_KEY=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Paths
VAULT_PATH=/app/vault
INBOX_PATH=/app/vault/Inbox
TEMPLATES_PATH=/app/vault/Templates
ARCHIVE_PATH=/app/vault/_Archive

# Limits
MAX_FILES_PER_BATCH=10
SIMILARITY_THRESHOLD=0.7
DUPLICATE_THRESHOLD=0.95
EMBEDDING_DIMENSION_MIN=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json